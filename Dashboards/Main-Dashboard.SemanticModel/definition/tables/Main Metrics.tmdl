			            FORMAT(_MIN, "#,##0"),
			
			        "Non Guest Favourite AirBNBs",
			            FORMAT(_MIN, "#,##0"),
			
			        "Guest Favourite AirBNBs",
			            FORMAT(_MIN, "#,##0"),
			
			        "Total Bedrooms",
			            FORMAT(_MIN, "#,##0"),
			
			        "Total Beds",
			            FORMAT(_MIN, "#,##0"),
			
