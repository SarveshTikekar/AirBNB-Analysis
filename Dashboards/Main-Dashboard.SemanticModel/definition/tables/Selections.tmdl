table Selections
	lineageTag: 37b6c38d-0872-4d49-8434-c0de1281b2d2

	measure 'Selected Currency' = IF(HASONEVALUE('Currency Converter'[Currency Name]), SELECTEDVALUE('Currency Converter'[Currency Name]), "US Dollar")
		lineageTag: ab16a952-6322-4024-9e0a-2b935f0a6273

	measure 'Selected Currency Symbol' = ```
			
			Var Curr = [Selected Currency] 
			RETURN 
			    LOOKUPVALUE('Currency Converter'[Currency Symbol], 'Currency Converter'[Currency Name], Curr)
			```
		lineageTag: 7c0e8ac1-5d9f-4496-b579-9232728086dd

	measure 'Selected Rate' = ```
			
			Var Curr = [Selected Currency] 
			RETURN 
			    LOOKUPVALUE('Currency Converter'[Value Wrt Usd], 'Currency Converter'[Currency Name], Curr)
			```
		formatString: "₹"\ #,0.###############;#,0.###############\ -"₹";"₹"\ #,0.###############
		lineageTag: 8fe1c05b-3692-4aa2-9f3d-a635ff650a9a

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure 'Selected AirBNB' = SELECTEDVALUE(Listings[Listing ID])
		formatString: 0
		lineageTag: 0e8e7fb5-4af8-4e9a-bcf9-98a49dbaa29d

	measure 'Is Selected AirBNB Superhost' = LOOKUPVALUE(Listings[Is SuperHost], Listings[Listing ID], Selections[Selected AirBNB])
