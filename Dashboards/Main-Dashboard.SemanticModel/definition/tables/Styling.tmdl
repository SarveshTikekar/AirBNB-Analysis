	measure 'Cover Photo' = ```
			
			VAR PhotoURL =
			    SELECTEDVALUE(Listings[Cover Photo])
			
			VAR Latitude =
			    SELECTEDVALUE('Listings'[Latitude])
			
			VAR Longitude =
			    SELECTEDVALUE('Listings'[Longitude])
			
			VAR City =
			    SELECTEDVALUE('Listings'[City])
			
			VAR Country =
			    LOOKUPVALUE(Cities[Country], Cities[City], City)
			
			RETURN
			"
			<style>
			/* CSS Reset & Overflow Prevention */
			.photo-wrapper, 
			.photo-wrapper * {
			    box-sizing: border-box !important;
			    margin: 0 !important;
			}
			
			.photo-wrapper {
			    position: absolute;
			    top: 0;
			    left: 0;
			    right: 0;
			    bottom: 0;
			    padding: 4px;
			    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
			    overflow: hidden !important;
			}
			
			/* Outer Crimson Card Frame using Grid */
			.photo-wrapper .photo-card {
			    display: grid;
			    grid-template-rows: 1fr 40px; /* Top fills available space, bottom locked to 40px */
			    gap: 8px;
			    
			    width: 100%;
			    height: 100%;
			    padding: 8px;
			    
			    background: #FAFAFA;
			    border: 3px solid #8B0000;
			    border-radius: 12px;
			    
			    box-shadow: 
			        0 4px 14px rgba(139, 0, 0, 0.15),
			        inset 0 0 0 1px #FFFFFF;
			    overflow: hidden !important;
			}
			
			/* Photo Canvas - Bound strictly to Row 1 */
			.photo-wrapper .photo-frame {
			    position: relative;
			    width: 100%;
			    height: 100%;
			    
			    border-radius: 6px;
			    overflow: hidden;
			    background: #F3F3F3;
			    border: 1px solid #E5E7EB;
			}
			
			/* Image fills Row 1 completely */
			.photo-wrapper .photo-frame img {
			    width: 100%;
			    height: 100%;
			    display: block;
			    object-fit: cover;
			    object-position: center;
			}
			
			.photo-wrapper .accent {
			    position: absolute;
			    top: 0;
			    left: 0;
			    width: 50px;
			    height: 4px;
			    background: linear-gradient(90deg, #8B0000, #DC143C);
			    z-index: 20;
			    border-bottom-right-radius: 4px;
			}
			
			/* Geotag Footer - Bound strictly to Row 2 */
			.photo-wrapper .geotag {
			    display: flex;
			    align-items: center;
			    justify-content: space-between;
			    
			    width: 100%;
			    height: 100%;
			    
			    padding: 0 12px;
			    background: #FCF2F4; 
			    border: 1px solid #F8DDE2;
			    border-radius: 6px;
			    gap: 8px;
			    overflow: hidden;
			}
			
			.photo-wrapper .location-main {
			    display: flex;
			    align-items: center;
			    gap: 6px;
			    min-width: 0; 
			}
			
			.photo-wrapper .location-main svg {
			    flex-shrink: 0;
			}
			
			.photo-wrapper .place {
			    font-size: 13px;
			    font-weight: 700;
			    color: #3B0912;
			    white-space: nowrap;
			    overflow: hidden;
			    text-overflow: ellipsis;
			}
			
			.photo-wrapper .coords {
			    display: flex;
			    align-items: center;
			    gap: 6px;
			    flex-shrink: 0; 
			}
			
			.photo-wrapper .coord-pill {
			    display: flex;
			    align-items: center;
			    gap: 4px;
			    background: #FFFFFF;
			    padding: 3px 7px;
			    border-radius: 5px;
			    border: 1px solid #F4C2CB;
			    font-size: 10px;
			    font-weight: 600;
			    color: #8A1529;
			}
			
			.photo-wrapper .coord-pill span {
			    line-height: 1;
			}
			</style>
			
			<div class='photo-wrapper'>
			    <div class='photo-card'>
			
			        <!-- COVER PHOTO (Grid Row 1) -->
			        <div class='photo-frame'>
			            <div class='accent'></div>
			            <img src='" & PhotoURL & "'>
			        </div>
			
			        <!-- GEOTAG INFORMATION (Grid Row 2) -->
			        <div class='geotag'>
			
			            <!-- LEFT: CITY / COUNTRY -->
			            <div class='location-main'>
			                <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='#DC143C' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'>
			                    <path d='M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z'></path>
			                    <circle cx='12' cy='10' r='3'></circle>
			                </svg>
			                <span class='place'>" & City & ", " & Country & "</span>
			            </div>
			
			            <!-- RIGHT: COORDINATES -->
			            <div class='coords'>
			                <div class='coord-pill'>
			                    <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' width='12' height='12' fill='none' stroke='#C95B6C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
			                        <circle cx='12' cy='12' r='10'></circle>
			                        <line x1='2' y1='12' x2='22' y2='12'></line>
			                    </svg>
			                    <span>" & FORMAT(Latitude, "0.0000") & "°</span>
			                </div>
			
			                <div class='coord-pill'>
			                    <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' width='12' height='12' fill='none' stroke='#C95B6C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
			                        <circle cx='12' cy='12' r='10'></circle>
			                        <path d='M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z'></path>
			                    </svg>
			                    <span>" & FORMAT(Longitude, "0.0000") & "°</span>
			                </div>
			            </div>
			
			        </div>
			    </div>
			</div>
			"
			```
		lineageTag: a0ede614-9076-4a6c-b6e6-3204facad2b8

	measure 'Photo Slideshow' = ```
			
			VAR PhotoTable =
			    FILTER(
			        VALUES('AirBNB Photos'[Photos]),
			        NOT ISBLANK('AirBNB Photos'[Photos])
			    )
			
			VAR PhotoCount =
			    COUNTROWS(PhotoTable)
			
			VAR DisplayTimePerImage = 4.0 -- Seconds an image stays visible
			VAR TransitionTime = 1.0     -- Seconds spent sliding
			
			VAR TimePerSlide = DisplayTimePerImage + TransitionTime
			VAR TotalTime = PhotoCount * TimePerSlide
			
			-- Calculate keyframe percentages dynamically so intervals are 100% uniform
			VAR HoldPct = (DisplayTimePerImage / TotalTime) * 100
			VAR TransPct = (TransitionTime / TotalTime) * 100
			
			VAR Keyframe_StartVisible = FORMAT(TransPct, "0.00") & "%"
			VAR Keyframe_EndVisible   = FORMAT(TransPct + HoldPct, "0.00") & "%"
			VAR Keyframe_ExitComplete = FORMAT((TransPct * 2) + HoldPct, "0.00") & "%"
			
			VAR Photos =
			    CONCATENATEX(
			        ADDCOLUMNS(
			            PhotoTable,
			            "__Index",
			                RANKX(
			                    PhotoTable,
			                    'AirBNB Photos'[Photos],
			                    ,
			                    ASC,
			                    DENSE
			                )
			        ),
			        VAR CurrentIndex = [__Index]
			        VAR Delay = (CurrentIndex - 1) * TimePerSlide
			        RETURN
			            "<div class='slide' style='animation-delay: " & FORMAT(Delay, "0.00") & "s;'>" &
			                "<img src='" & 'AirBNB Photos'[Photos] & "'>" &
			                "<div class='counter-overlay'>" & CurrentIndex & " / " & PhotoCount & "</div>" &
			            "</div>",
			        ""
			    )
			
			RETURN
			"
			<style>
			/* Reset & Canvas Setup */
			.photo-wrapper, 
			.photo-wrapper * {
			    box-sizing: border-box !important;
			    margin: 0 !important;
			}
			
			.photo-wrapper {
			    position: absolute;
			    top: 0;
			    left: 0;
			    right: 0;
			    bottom: 0;
			    padding: 4px;
			    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
			    overflow: hidden !important;
			}
			
			/* Crimson Frame Card */
			.photo-wrapper .photo-card {
			    display: grid;
			    grid-template-rows: 1fr 34px;
			    gap: 8px;
			    
			    width: 100%;
			    height: 100%;
			    padding: 8px;
			    
			    background: #FAFAFA;
			    border: 3px solid #8B0000;
			    border-radius: 12px;
			    
			    box-shadow: 
			        0 4px 14px rgba(139, 0, 0, 0.15),
			        inset 0 0 0 1px #FFFFFF;
			    overflow: hidden !important;
			}
			
			/* Slideshow Viewport */
			.photo-wrapper .photo-frame {
			    position: relative;
			    width: 100%;
			    height: 100%;
			    
			    border-radius: 6px;
			    overflow: hidden;
			    background: #111111;
			    border: 1px solid #E5E7EB;
			}
			
			/* Individual Slide */
			.photo-wrapper .slide {
			    position: absolute;
			    top: 0;
			    left: 0;
			    width: 100%;
			    height: 100%;
			
			    animation-name: dynamicSlideShow;
			    animation-duration: " & FORMAT(TotalTime, "0.00") & "s;
			    animation-timing-function: ease-in-out;
			    animation-iteration-count: infinite;
			
			    /* Hidden off-screen right by default */
			    transform: translateX(100%);
			}
			
			.photo-wrapper .slide img {
			    width: 100%;
			    height: 100%;
			    display: block;
			    object-fit: cover;
			    object-position: center;
			}
			
			/* Dynamic Animation Steps to Guarantee Uniform Intervals */
			@keyframes dynamicSlideShow {
			    0% {
			        transform: translateX(100%);
			    }
			    " & Keyframe_StartVisible & " {
			        transform: translateX(0%);
			    }
			    " & Keyframe_EndVisible & " {
			        transform: translateX(0%);
			    }
			    " & Keyframe_ExitComplete & " {
			        transform: translateX(-100%);
			    }
			    100% {
			        transform: translateX(-100%);
			    }
			}
			
			/* Accent Header Ribbon */
			.photo-wrapper .accent {
			    position: absolute;
			    top: 0;
			    left: 0;
			    width: 50px;
			    height: 4px;
			    background: linear-gradient(90deg, #8B0000, #DC143C);
			    z-index: 20;
			    border-bottom-right-radius: 4px;
			}
			
			.photo-wrapper .gradient {
			    position: absolute;
			    inset: 0;
			    background: linear-gradient(
			        to bottom,
			        rgba(0,0,0,0) 60%,
			        rgba(0,0,0,0.25) 100%
			    );
			    z-index: 5;
			    pointer-events: none;
			}
			
			/* Image Counter Overlay Inside Image (Per Slide) */
			.photo-wrapper .counter-overlay {
			    position: absolute;
			    bottom: 8px;
			    right: 8px;
			    z-index: 10;
			    
			    background: rgba(0, 0, 0, 0.65);
			    color: #FFFFFF;
			    padding: 3px 8px;
			    border-radius: 4px;
			    font-size: 10px;
			    font-weight: 600;
			    backdrop-filter: blur(2px);
			}
			
			/* Centered Crimson Footer */
			.photo-wrapper .slideshow-footer {
			    display: flex;
			    align-items: center;
			    justify-content: center;
			    
			    width: 100%;
			    height: 100%;
			    
			    background: #FCF2F4; 
			    border: 1px solid #F8DDE2;
			    border-radius: 6px;
			    overflow: hidden;
			}
			
			.photo-wrapper .counter-pill {
			    display: flex;
			    align-items: center;
			    justify-content: center;
			    gap: 6px;
			    
			    background: #FFFFFF;
			    padding: 3px 14px;
			    border-radius: 5px;
			    border: 1px solid #F4C2CB;
			    
			    color: #8A1529;
			    font-size: 11px;
			    font-weight: 700;
			    letter-spacing: 0.5px;
			}
			</style>
			
			<div class='photo-wrapper'>
			    <div class='photo-card'>
			
			        <!-- SLIDESHOW FRAME -->
			        <div class='photo-frame'>
			            <div class='accent'></div>
			            " & Photos & "
			            <div class='gradient'></div>
			        </div>
			
			        <!-- FOOTER COUNTER -->
			        <div class='slideshow-footer'>
			            <div class='counter-pill'>
			                <span>PHOTOS (" & PhotoCount & ")</span>
			            </div>
			        </div>
			
			    </div>
			</div>
			"
			```
		lineageTag: 8409b407-d4cf-4037-bace-273a286e3ba8

	column Col
		lineageTag: a8c779c6-e732-43b2-886b-073503bc4804
		summarizeBy: none
		isNameInferred
		sourceColumn: [Col]

		annotation SummarizationSetBy = Automatic

	partition Styling = calculated
		mode: import
		source = DATATABLE("Col", TEXT, {{"_"}})

	annotation PBI_Id = 0d86114d39db4a52a98c6e49ae02e48d

