			        'elevator': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'></path><circle cx='12' cy='7' r='4'></circle></svg>`,
			        'doorman': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'></path><circle cx='12' cy='7' r='4'></circle></svg>`,
			        'staff': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'></path><circle cx='12' cy='7' r='4'></circle></svg>`,
			
			        // Family & Pets
			        'crib': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'></circle><path d='M8 14s1.5 2 4 2 4-2 4-2'></path></svg>`,
			        'baby': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'></circle><path d='M8 14s1.5 2 4 2 4-2 4-2'></path></svg>`,
			        'children': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'></circle><path d='M8 14s1.5 2 4 2 4-2 4-2'></path></svg>`,
			        'pet': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><circle cx='11' cy='4' r='2'></circle><circle cx='18' cy='8' r='2'></circle><path d='M9 10a5 5 0 0 1 5 5v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-3a5 5 0 0 1 5-5z'></path></svg>`
			    };
			
			    // Clean checkmark fallback icon
			    const defaultIcon = `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6L9 17l-5-5'></path></svg>`;
			
			    // Iterate through tags and set matched icon
			    document.querySelectorAll('.amenity-wrapper .amenity').forEach(el => {
			        const text = el.querySelector('.name').innerText.toLowerCase();
			        let matchedSvg = defaultIcon;
			
			        for (const key in iconMap) {
			            if (text.includes(key)) {
			                matchedSvg = iconMap[key];
			                break;
			            }
			        }
			
			        el.querySelector('.icon-box').innerHTML = matchedSvg;
			    });
			})();
			</script>
			"
			```
