table Styling
	lineageTag: ca990854-228d-4197-9ad6-1ab9f5c0c357

	measure 'Amenity Tags' = ```
			
			------------------------------------------------------------------
			-- 1. Measure Tag Values & Dynamic Building
			------------------------------------------------------------------
			VAR _Bedrooms            = [Selected AirBNB Bedrooms]
			VAR _Beds                = [Selected AirBNB Beds]
			VAR _IsGuestFavorite     = [Is Selected AirBNB GuestFavourite]
			VAR _IsInstantlyBookable = [Is Selected AirBNB Instantly Booked]
			VAR _IsRegistered        = [Is Selected AirBNB Registered]
			VAR _IsSuperhost         = [Is Selected AirBNB Superhost]
			VAR _ListingType         = [Selected AirBNB Listing Type]
			
			VAR _TagSuperhost = 
			    IF(
			        _IsSuperhost, 
			        "<div class='amenity measure-tag measure-highlight'>" &
			            "<span class='icon-box'><svg class='tag-icon-white' viewBox='0 0 24 24' fill='currentColor'><path d='M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z'/></svg></span>" &
			            "<span class='name'>Superhost</span>" &
			        "</div>", 
			        ""
			    )
			
			VAR _TagGuestFav = 
			    IF(
			        _IsGuestFavorite, 
			        "<div class='amenity measure-tag'>" &
			            "<span class='icon-box'><svg class='tag-icon-white' viewBox='0 0 24 24' fill='currentColor'><path d='M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z'/></svg></span>" &
			            "<span class='name'>Guest Favorite</span>" &
			        "</div>", 
			        ""
			    )
			
			VAR _TagInstantBook = 
			    IF(
			        _IsInstantlyBookable, 
			        "<div class='amenity measure-tag'>" &
			            "<span class='icon-box'><svg class='tag-icon-white' viewBox='0 0 24 24' fill='currentColor'><path d='M7 2v11h3v9l7-12h-4l4-8z'/></svg></span>" &
			            "<span class='name'>Instant Book</span>" &
			        "</div>", 
			        ""
			    )
			
			VAR _TagRegistered = 
			    IF(
			        _IsRegistered, 
			        "<div class='amenity measure-tag'>" &
			            "<span class='icon-box'><svg class='tag-icon-white' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'/></svg></span>" &
			            "<span class='name'>Registered</span>" &
			        "</div>", 
			        ""
			    )
			
			VAR _TagListingType = 
			    IF(
			        NOT(ISBLANK(_ListingType)) && _ListingType <> "-", 
			        "<div class='amenity measure-tag measure-outline'>" &
			            "<span class='name'>" & _ListingType & "</span>" &
			        "</div>", 
			        ""
			    )
			
			VAR _TagBedrooms = 
			    IF(
			        NOT(ISBLANK(_Bedrooms)) && _Bedrooms > 0, 
			        "<div class='amenity measure-tag'>" &
			            "<span class='icon-box'><svg class='tag-icon-white' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 21h18M3 7v14M21 7v14M6 7V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v3M9 14h6M9 18h6'/></svg></span>" &
			            "<span class='name'>" & _Bedrooms & IF(_Bedrooms = 1, " Bedroom", " Bedrooms") & "</span>" &
			        "</div>", 
			        ""
			    )
			
			VAR _TagBeds = 
			    IF(
			        NOT(ISBLANK(_Beds)) && _Beds > 0, 
			        "<div class='amenity measure-tag'>" &
			            "<span class='icon-box'><svg class='tag-icon-white' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M2 4v16M2 8h20v12M2 17h20M6 8v4M10 8v4'/></svg></span>" &
			            "<span class='name'>" & _Beds & IF(_Beds = 1, " Bed", " Beds") & "</span>" &
			        "</div>", 
			        ""
			    )
			
			-- Bedrooms and Beds placed at the very start of the top stack
			VAR MeasureTagsHTML = _TagSuperhost & _TagGuestFav & _TagInstantBook & _TagRegistered & _TagListingType & _TagBedrooms & _TagBeds
			
			------------------------------------------------------------------
			-- 2. Amenity Table Tags Building
			------------------------------------------------------------------
			VAR AmenitiesTagsHTML =
			    CONCATENATEX(
			        FILTER(
			            VALUES('Listing Amenities'[Amenities]),
			            NOT ISBLANK('Listing Amenities'[Amenities])
			        ),
			        "<div class='amenity'>" &
			            "<span class='icon-box'></span>" &
			            "<span class='name'>" & 'Listing Amenities'[Amenities] & "</span>" &
			        "</div>",
			        ""
			    )
			
			------------------------------------------------------------------
			-- 3. Render Combined HTML Output
			------------------------------------------------------------------
			RETURN
			"
			<style>
			/* Canvas Setup & Reset */
			.amenity-wrapper, 
			.amenity-wrapper * {
			    box-sizing: border-box !important;
			    margin: 0 !important;
			}
			
			.amenity-wrapper {
			    position: absolute;
			    top: 0;
			    left: 0;
			    right: 0;
			    bottom: 0;
			    padding: 8px;
			    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
			    overflow: hidden !important;
			    background: transparent !important;
			}
			
			/* Flex Container for Amenities */
			.amenity-wrapper .tags-container {
			    display: flex;
			    flex-wrap: wrap;
			    align-content: flex-start;
			    gap: 12px;
			    
			    width: 100%;
			    height: 100%;
			    padding: 6px;
			    
			    overflow-y: auto !important;
			    overflow-x: hidden;
			}
			
			/* Custom Scrollbar */
			.amenity-wrapper .tags-container::-webkit-scrollbar {
			    width: 6px;
			}
			.amenity-wrapper .tags-container::-webkit-scrollbar-track {
			    background: transparent;
			}
			.amenity-wrapper .tags-container::-webkit-scrollbar-thumb {
			    background: #E5E7EB;
			    border-radius: 4px;
			}
			.amenity-wrapper .tags-container::-webkit-scrollbar-thumb:hover {
			    background: #8B0000;
			}
			
			/* Rounded Box Pill Tag (Slightly Larger Pill Design) */
			.amenity-wrapper .amenity {
			    display: inline-flex;
			    align-items: center;
			    gap: 10px;
			    
			    padding: 10px 20px;
			    height: 44px;
			    
			    background: #FFFFFF;
			    border: 1.5px solid #E5E7EB;
			    border-radius: 22px;
			    
			    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.04);
			    transition: all 0.2s ease-in-out;
			    cursor: default;
			}
			
			.amenity-wrapper .amenity:hover {
			    background: #FCF2F4;
			    border-color: #F4C2CB;
			    transform: translateY(-1px);
			    box-shadow: 0 4px 10px rgba(139, 0, 0, 0.1);
			}
			
			.amenity-wrapper .icon-box {
			    display: flex;
			    align-items: center;
			    justify-content: center;
			}
			
			/* Scaled Up SVG Icons */
			.amenity-wrapper .tag-icon {
			    width: 20px;
			    height: 20px;
			    flex-shrink: 0;
			}
			
			.amenity-wrapper .tag-icon-white {
			    width: 18px;
			    height: 18px;
			    flex-shrink: 0;
			    color: #FFFFFF;
			}
			
			/* Typography (16px) */
			.amenity-wrapper .name {
			    font-size: 16px;
			    font-weight: 600;
			    color: #222222;
			    white-space: nowrap;
			    line-height: 1;
			}
			
			/* Highlighted Top Measure Tags Styling */
			.amenity-wrapper .measure-tag {
			    background: linear-gradient(135deg, #8B0000 0%, #B81D43 100%) !important;
			    border: 1.5px solid #8B0000 !important;
			    box-shadow: 0 3px 8px rgba(139, 0, 0, 0.28) !important;
			}
			
			.amenity-wrapper .measure-tag .name {
			    color: #FFFFFF !important;
			    font-weight: 700 !important;
			}
			
			.amenity-wrapper .measure-tag:hover {
			    transform: translateY(-1px);
			    box-shadow: 0 6px 12px rgba(139, 0, 0, 0.38) !important;
			}
			
			.amenity-wrapper .measure-highlight {
			    background: linear-gradient(135deg, #D81B60 0%, #FF2A5B 100%) !important;
			    border: 1.5px solid #D81B60 !important;
			}
			
			.amenity-wrapper .measure-outline {
			    background: #FFF0F3 !important;
			    border: 1.5px solid #F4C2CB !important;
			}
			
			.amenity-wrapper .measure-outline .name {
			    color: #8B0000 !important;
			}
			</style>
			
			<div class='amenity-wrapper'>
			    <div class='tags-container'>
			        " & MeasureTagsHTML & "
			        " & AmenitiesTagsHTML & "
			    </div>
			</div>
			
			<script>
			(function() {
			    // Complete JS Icon Map for all 115+ Amenities
			    const iconMap = {
			        // Tech & Media
			        'wifi': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12.55a11 11 0 0 1 14 0'></path><path d='M1.42 9a16 16 0 0 1 21.16 0'></path><path d='M8.53 16.11a6 6 0 0 1 6.95 0'></path><line x1='12' y1='20' x2='12.01' y2='20' stroke-width='3'></line></svg>`,
			        'tv': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='7' width='20' height='13' rx='2'></rect><polyline points='17 2 12 7 7 2'></polyline></svg>`,
			        'cable': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='7' width='20' height='13' rx='2'></rect><polyline points='17 2 12 7 7 2'></polyline></svg>`,
			        'ethernet': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><rect x='4' y='4' width='16' height='16' rx='2'></rect><rect x='9' y='9' width='6' height='6'></rect><line x1='9' y1='1' x2='9' y2='4'></line><line x1='15' y1='1' x2='15' y2='4'></line></svg>`,
			        'outlet': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><rect x='4' y='4' width='16' height='16' rx='2'></rect><line x1='9' y1='1' x2='9' y2='4'></line><line x1='15' y1='1' x2='15' y2='4'></line></svg>`,
			        'sound system': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M9 18V5l12-2v13'></path><circle cx='6' cy='18' r='3'></circle><circle cx='18' cy='16' r='3'></circle></svg>`,
			        'record player': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M9 18V5l12-2v13'></path><circle cx='6' cy='18' r='3'></circle><circle cx='18' cy='16' r='3'></circle></svg>`,
			        'game console': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><line x1='6' y1='12' x2='10' y2='12'></line><line x1='8' y1='10' x2='8' y2='14'></line><circle cx='15' cy='13' r='1'></circle><circle cx='18' cy='11' r='1'></circle><rect x='2' y='6' width='20' height='12' rx='4'></rect></svg>`,
			        'arcade': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><line x1='6' y1='12' x2='10' y2='12'></line><line x1='8' y1='10' x2='8' y2='14'></line><circle cx='15' cy='13' r='1'></circle><circle cx='18' cy='11' r='1'></circle><rect x='2' y='6' width='20' height='12' rx='4'></rect></svg>`,
			        'movie theater': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='7' width='20' height='13' rx='2'></rect><polyline points='17 2 12 7 7 2'></polyline></svg>`,
			
			        // Climate Control
			        'air conditioning': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 2v20M2 12h20M4.93 4.93l14.14 14.14M4.93 19.07l14.14-14.14'></path></svg>`,
			        'fan': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 12c2-3 5-3 5 0s-3 5 0 5-3-5 0-5'></path><circle cx='12' cy='12' r='2'></circle></svg>`,
			        'heating': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3s.5.5.5 0z'></path></svg>`,
			        'fireplace': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3s.5.5.5 0z'></path></svg>`,
			        'fire pit': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3s.5.5.5 0z'></path></svg>`,
			
			        // Kitchen & Dining
			        'kitchen': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M18 8v6M6 8v6M12 2v20M2 12h20'></path></svg>`,
			        'refrigerator': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><rect x='5' y='2' width='14' height='20' rx='2'></rect><line x1='5' y1='10' x2='19' y2='10'></line></svg>`,
			        'fridge': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><rect x='5' y='2' width='14' height='20' rx='2'></rect><line x1='5' y1='10' x2='19' y2='10'></line></svg>`,
			        'freezer': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><rect x='5' y='2' width='14' height='20' rx='2'></rect><line x1='5' y1='10' x2='19' y2='10'></line></svg>`,
			        'coffee': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M18 8h1a4 4 0 0 1 0 8h-1'></path><path d='M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z'></path></svg>`,
			        'kettle': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M18 8h1a4 4 0 0 1 0 8h-1'></path><path d='M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z'></path></svg>`,
			        'microwave': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='4' width='20' height='16' rx='2'></rect><path d='M6 8h12M6 12h12'></path></svg>`,
			        'oven': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='4' width='20' height='16' rx='2'></rect><path d='M6 8h12M6 12h12'></path></svg>`,
			        'stove': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='4' width='20' height='16' rx='2'></rect><path d='M6 8h12M6 12h12'></path></svg>`,
			        'toaster': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='4' width='20' height='16' rx='2'></rect></svg>`,
			        'blender': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='4' width='20' height='16' rx='2'></rect></svg>`,
			        'dish washer': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='4' width='20' height='16' rx='2'></rect></svg>`,
			        'dishwasher': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='4' width='20' height='16' rx='2'></rect></svg>`,
			        'bbq': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'></circle><path d='M8 12h8M12 8v8'></path></svg>`,
			        'grill': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'></circle><path d='M8 12h8M12 8v8'></path></svg>`,
			        'wine': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M8 22h8M12 15v7M7 2h10l-1 7a4 4 0 0 1-8 0L7 2z'></path></svg>`,
			        'dining': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M8 22h8M12 15v7M7 2h10l-1 7a4 4 0 0 1-8 0L7 2z'></path></svg>`,
			        'breakfast': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M18 10h-12a2 2 0 0 0 -2 2v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-7a2 2 0 0 0 -2 -2z'></path></svg>`,
			
			        // Water, Bathroom & Personal Care
			        'hot water': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z'></path></svg>`,
			        'shower': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z'></path></svg>`,
			        'bidet': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z'></path></svg>`,
			        'bathtub': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M2 12h20v4a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4v-4z'></path></svg>`,
			        'soap': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M9 2h6v3H9zM7 5h10v17H7z'></path></svg>`,
			        'shampoo': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M9 2h6v3H9zM7 5h10v17H7z'></path></svg>`,
			        'conditioner': `<svg class='tag-icon' viewBox='0 0 24 24' fill='none' stroke='#8B0000' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M9 2h6v3H9zM7 5h10v17H7z'></path></svg>`,
